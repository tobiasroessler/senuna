<?xml version="1.0" encoding="UTF-8"?>
<!--
  The hello process with the extra parts a modeler like Camunda Modeler adds:
  the diagram (BPMNDI), documentation, extension elements, a text annotation.
  The parser skips all of them.
-->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  id="hello_definitions"
                  targetNamespace="http://senuna.example">
  <bpmn:process id="hello" name="Hello" isExecutable="true">
    <bpmn:documentation>Greets someone by name.</bpmn:documentation>
    <bpmn:startEvent id="start" name="Start">
      <bpmn:outgoing>flow1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="flow1" sourceRef="start" targetRef="greet" />
    <bpmn:serviceTask id="greet" name="Greet">
      <bpmn:documentation>Handled by the "greet" handler.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="owner" value="team-a" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow1</bpmn:incoming>
      <bpmn:outgoing>flow2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="flow2" sourceRef="greet" targetRef="end" />
    <bpmn:endEvent id="end" name="End">
      <bpmn:incoming>flow2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:textAnnotation id="note">
      <bpmn:text>Needs the variable "name"</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="note_link" sourceRef="greet" targetRef="note" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="hello_diagram">
    <bpmndi:BPMNPlane id="hello_plane" bpmnElement="hello">
      <bpmndi:BPMNShape id="start_shape" bpmnElement="start">
        <dc:Bounds x="152" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="greet_shape" bpmnElement="greet">
        <dc:Bounds x="240" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_shape" bpmnElement="end">
        <dc:Bounds x="392" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="note_shape" bpmnElement="note">
        <dc:Bounds x="340" y="10" width="160" height="30" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow1_edge" bpmnElement="flow1">
        <di:waypoint x="188" y="120" />
        <di:waypoint x="240" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow2_edge" bpmnElement="flow2">
        <di:waypoint x="340" y="120" />
        <di:waypoint x="392" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="note_link_edge" bpmnElement="note_link">
        <di:waypoint x="320" y="80" />
        <di:waypoint x="370" y="40" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
